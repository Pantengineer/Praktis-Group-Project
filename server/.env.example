# Server Configuration
PORT=5001
NODE_ENV=development

# MySQL / MariaDB Configuration
MYSQL_HOST=mysql
MYSQL_USER=root
MYSQL_PASS=root
MYSQL_ROOT_PASSWORD=root
MYSQL_DB_NAME=praktis_db
MYSQL_DATABASE=praktis_db
MYSQL_DIALECT=mysql

# MongoDB Configuration
MONGO_URI=mongodb://mongodb:27017/praktis_db

# JWT Secret (Generate a strong random string - minimum 32 characters)
JWT_SECRET=your_super_secret_key_change_this_in_production_minimum_32_chars

# Initial Seed Credentials (used by npm run seed)
# Admin Role
ADMIN_NAME=Mr. Admin
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=adminpassword
ADMIN_NIM=0000000000

# Mahasiswa & Asdos Default Password
MHS_PASSWORD=mhspassword

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging Level (debug, info, warn, error)
LOG_LEVEL=debug

# File Upload Limit (in MB)
MAX_FILE_SIZE=50

